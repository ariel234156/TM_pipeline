# Real, machine-specific config -- copy pipeline_config.example.yaml to
# make your own; don't commit it, it hardcodes absolute paths.
pipeline_config.yaml

__pycache__/
*.pyc

# Default output_dir names from pipeline_config.example.yaml, in case
# someone runs the pipeline from inside a checkout of this repo.
isonet2_input/
deconv/
mask/
isonet_maps/
corrected_tomos/

# Numbered configs (./pipeline new) and this machine's launcher settings:
# real paths of whoever made them.
configs/*.yaml
pipeline.local
pipeline.local.tmp.*

# IsoNet2's prepare_star writes this into the folder it runs in (the
# pipeline now runs it in the star file's folder; older runs left it here)
.to_node.json
